#!/usr/bin/make -f
export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_install:
	dh_auto_install
	rm -f debian/bitcoin-knots/usr/bin/test_bitcoin
	rm -f debian/bitcoin-knots/usr/bin/bench_bitcoin
	rm -rf debian/bitcoin-knots/usr/lib
	rm -rf debian/bitcoin-knots/usr/include

override_dh_installexamples:
	dh_installexamples share/examples/bitcoin.conf

override_dh_auto_clean:
	dh_clean
	rm -f src/test/stats_tests.log
