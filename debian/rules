#!/usr/bin/make -f
export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_configure:
	./autogen.sh
	./configure --with-gui=no --disable-bench --prefix=/usr CPPFLAGS="-Wdate-time -D_FORTIFY_SOURCE=2" --disable-silent-rules > /dev/null

override_dh_auto_build:
	make

override_dh_auto_test:
	make check

override_dh_auto_clean:
	dh_clean
	rm -f src/test/stats_tests.log
