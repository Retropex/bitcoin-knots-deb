	done
fi
unset RET

db_reset bitcoin-knots/maxorphantx || true
db_input low bitcoin-knots/maxorphantx || db_set bitcoin-knots/maxorphantx ""
db_go || true

db_get bitcoin-knots/maxorphantx || RET=
if [ "$RET" ]; then
	while true; do
	if echo "$RET" | grep -sqE '^[0-9]+$' && [ "$RET" -ge 0 ]; then
		break
	fi
	db_input high bitcoin-knots/maxorphantx-wrong || true
	db_go || true
	db_input low bitcoin-knots/maxorphantx || true
