db_get bitcoin-knots/blockmaxsize || RET=
if [ "$RET" ]; then
	while true; do
	if echo "$RET" | grep -sqE '^[0-9]+$' && { [ "$RET" -ge 0 ] && [ "$RET" -le 3985000 ] ; }; then
		break
	fi
	db_input high bitcoin-knots/blockmaxsize-wrong || true
	db_go || true
	db_input low bitcoin-knots/blockmaxsize || true
	db_go || true
