#!/bin/sh
# Exit immediately if a command produces an error.
set -e
# Source debconf library
. /usr/share/debconf/confmodule

if [ ! -f /etc/bitcoin/bitcoin.conf ]; then
	db_input high bitcoin-knots/bitcoinconf || true
	db_go || true
	exit 0
fi

db_reset bitcoin-knots/prune-bool || true
db_input medium bitcoin-knots/prune-bool || db_set bitcoin-knots/prune-bool ""
db_go || true

db_get bitcoin-knots/prune-bool || RET=
if [ "$RET" = "true" ];then
	db_reset bitcoin-knots/prune || true
	db_input medium bitcoin-knots/prune || db_set bitcoin-knots/prune ""
	db_go || true
	
	db_get bitcoin-knots/prune || RET=
	if [ "$RET" ]; then
		while true; do
		  if echo "$RET" | grep -sqE '^[0-9]+$' && { [ "$RET" -eq 0 ] || [ "$RET" -eq 1 ] || [ "$RET" -ge 550 ]; }; then
		    break
		  fi
		  db_input high bitcoin-knots/prune-fail || true
		  db_go || true
		  db_input medium bitcoin-knots/prune || true
		  db_go || true
		  db_get bitcoin-knots/prune || RET=
		done
	fi
	unset RET
	
	AUTOSIZE=$(df -m /var/lib/bitcoin 2>/dev/null | awk 'NR==2 {print $4}')
	if [ -z "$AUTOSIZE" ]; then
		db_reset bitcoin-knots/pruneduringinit || true
	else
		db_set bitcoin-knots/pruneduringinit $(awk "BEGIN {printf \"%d\", $AUTOSIZE * 0.4}")
	fi	
	
	db_input low bitcoin-knots/pruneduringinit || db_set bitcoin-knots/pruneduringinit ""
	db_go || true
	db_get bitcoin-knots/pruneduringinit || RET=
	if [ "$RET" ]; then
		while true; do
		if echo "$RET" | grep -sqE '^-?[0-9]+$' && { [ "$RET" -eq -1 ] || [ "$RET" -eq 0 ] || [ "$RET" -eq 1 ] || [ "$RET" -ge 550 ]; }; then
			break
		fi
		db_input high bitcoin-knots/pruneduringinit-wrong || true
		db_go || true
		db_input low bitcoin-knots/pruneduringinit || true
		db_go || true
		db_get bitcoin-knots/pruneduringinit || RET=
		done
	fi
fi

if [ "$RET" = "false" ];then
	db_reset bitcoin-knots/txindex || true
	db_input medium bitcoin-knots/txindex || db_set bitcoin-knots/txindex ""
	db_go || true
fi
unset RET

db_reset bitcoin-knots/dbcache || true
db_input medium bitcoin-knots/dbcache || db_set bitcoin-knots/dbcache ""
db_go || true

db_get bitcoin-knots/dbcache || RET=
if [ "$RET" ]; then
	while true; do
	if echo "$RET" | grep -sqE '^[0-9]+$' && [ "$RET" -ge 4 ]; then
		break
	fi
	db_input high bitcoin-knots/dbcache-wrong || true
	db_go || true
	db_input medium bitcoin-knots/dbcache || true
	db_go || true
	db_get bitcoin-knots/dbcache || RET=
	done
fi
unset RET

db_reset bitcoin-knots/rpcthreads || true
db_input low bitcoin-knots/rpcthreads || db_set bitcoin-knots/rpcthreads ""
db_go || true

db_get bitcoin-knots/rpcthreads || RET=
if [ "$RET" ]; then
	while true; do
	if echo "$RET" | grep -sqE '^[0-9]+$' && [ "$RET" -ge 0 ]; then
		break
	fi
	db_input high bitcoin-knots/rpcthreads-wrong || true
	db_go || true
	db_input low bitcoin-knots/rpcthreads || true
	db_go || true
	db_get bitcoin-knots/rpcthreads || RET=
	done
fi
unset RET

db_reset bitcoin-knots/rpcworkqueue || true
db_input low bitcoin-knots/rpcworkqueue || db_set bitcoin-knots/rpcworkqueue ""
db_go || true

db_get bitcoin-knots/rpcworkqueue || RET=
if [ "$RET" ]; then
	while true; do
	if echo "$RET" | grep -sqE '^[0-9]+$' && [ "$RET" -ge 0 ]; then
		break
	fi
	db_input high bitcoin-knots/rpcworkqueue-wrong || true
	db_go || true
	db_input low bitcoin-knots/rpcworkqueue || true
	db_go || true
	db_get bitcoin-knots/rpcworkqueue || RET=
	done
fi
unset RET