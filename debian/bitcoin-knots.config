	while true; do
	if echo "$RET" | grep -sqE '^[0-9]+$' && { [ "$RET" -ge 0 ] && [ "$RET" -le 4000000 ] ; }; then
		break
	fi
	db_input high bitcoin-knots/blockprioritysize-wrong || true
	db_go || true
	db_input low bitcoin-knots/blockprioritysize || true
	db_go || true
	db_get bitcoin-knots/blockprioritysize || RET=
	done
fi
unset RET

