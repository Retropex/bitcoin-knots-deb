#!/bin/sh
# Exit immediately if a command produces an error.
set -e
# Source debconf library
. /usr/share/debconf/confmodule

maybe_reset() {
    if [ "$1" = "reconfigure" ] || [ -n "$DEBCONF_RECONFIGURE" ]; then
        db_reset "$2" || true
    fi
}

ask_or_clear() {
    local priority="$1"
    local question="$2"
    db_input "$priority" "$question" || {
        db_fget "$question" seen || true
        if [ "$RET" != "true" ]; then
            db_set "$question" ""
        fi
    }
}

maybe_reset "$1" bitcoin-knots/prune-bool
ask_or_clear medium bitcoin-knots/prune-bool
db_go || true

db_get bitcoin-knots/prune-bool || RET=
if [ "$RET" = "true" ];then
	maybe_reset "$1" bitcoin-knots/prune
	ask_or_clear medium bitcoin-knots/prune
	db_go || true
	
	db_get bitcoin-knots/prune || RET=
	if [ "$RET" ]; then
		while true; do
		  if echo "$RET" | grep -sqE '^[0-9]+$' && { [ "$RET" -eq 0 ] || [ "$RET" -eq 1 ] || [ "$RET" -ge 550 ]; }; then
		    break
		  fi
		  db_input high bitcoin-knots/prune-fail || true
		  db_go || true
		  db_input medium bitcoin-knots/prune || true
		  db_go || true
		  db_get bitcoin-knots/prune || RET=
		done
	fi
	unset RET
	
	AUTOSIZE=$(df -m /var/lib/bitcoin 2>/dev/null | awk 'NR==2 {print $4}')
	if [ -n "$AUTOSIZE" ] && echo "$AUTOSIZE" | grep -qE '^[0-9]+$'; then
		db_set bitcoin-knots/pruneduringinit $(awk "BEGIN {printf \"%d\", $AUTOSIZE * 0.4}")
	else
		maybe_reset "$1" bitcoin-knots/pruneduringinit
	fi
	
	ask_or_clear low bitcoin-knots/pruneduringinit
	db_go || true
	db_get bitcoin-knots/pruneduringinit || RET=
	if [ "$RET" ]; then
		while true; do
		if echo "$RET" | grep -sqE '^-?[0-9]+$' && { [ "$RET" -eq -1 ] || [ "$RET" -eq 0 ] || [ "$RET" -eq 1 ] || [ "$RET" -ge 550 ]; }; then
			break
		fi
		db_input high bitcoin-knots/pruneduringinit-wrong || true
		db_go || true
		db_input low bitcoin-knots/pruneduringinit || true
		db_go || true
		db_get bitcoin-knots/pruneduringinit || RET=
		done
	fi
elif [ "$RET" = "false" ];then
	maybe_reset "$1" bitcoin-knots/txindex
	ask_or_clear medium bitcoin-knots/txindex
	db_go || true
fi
unset RET

maybe_reset "$1" bitcoin-knots/datacarriersize
ask_or_clear medium bitcoin-knots/datacarriersize
db_go || true

db_get bitcoin-knots/datacarriersize || RET=
if [ "$RET" ]; then
	while true; do
	if echo "$RET" | grep -sqE '^[0-9]+$' && [ "$RET" -ge 0 ]; then
		break
	fi
	db_input high bitcoin-knots/datacarriersize-wrong || true
	db_go || true
	db_input medium bitcoin-knots/datacarriersize || true
	db_go || true
	db_get bitcoin-knots/datacarriersize || RET=
	done
fi
unset RET

maybe_reset "$1" bitcoin-knots/dbcache
ask_or_clear medium bitcoin-knots/dbcache
db_go || true

db_get bitcoin-knots/dbcache || RET=
if [ "$RET" ]; then
	while true; do
	if echo "$RET" | grep -sqE '^[0-9]+$' && [ "$RET" -ge 4 ]; then
		break
	fi
	db_input high bitcoin-knots/dbcache-wrong || true
	db_go || true
	db_input medium bitcoin-knots/dbcache || true
