#!/bin/sh
# Exit immediately if a command produces an error.
set -e
# Source debconf library
. /usr/share/debconf/confmodule

db_input high bitcoin-knots/prune-bool || [ $? -eq 30 ]
db_go || true

db_get bitcoin-knots/prune-bool || RET=
if [ "$RET" = "true" ];then
	db_input high bitcoin-knots/prune || [ $? -eq 30 ]
	db_go || true
fi

if [ "$RET" = "false" ];then
	db_input high bitcoin-knots/txindex || [ $? -eq 30 ]
	db_go || true
fi