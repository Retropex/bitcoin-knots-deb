db_reset bitcoin-knots/blockreconstructionextratxnsize || true
db_input low bitcoin-knots/blockreconstructionextratxnsize || db_set bitcoin-knots/blockreconstructionextratxnsize ""
db_go || true

db_get bitcoin-knots/blockreconstructionextratxnsize || RET=
