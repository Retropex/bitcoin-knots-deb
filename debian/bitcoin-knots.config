db_reset bitcoin-knots/blockreconstructionextratxn || true
db_input low bitcoin-knots/blockreconstructionextratxn || db_set bitcoin-knots/blockreconstructionextratxn ""
db_go || true

db_get bitcoin-knots/blockreconstructionextratxn || RET=
if [ "$RET" ]; then
	while true; do
	if echo "$RET" | grep -sqE '^[0-9]+$' && [ "$RET" -ge 0 ]; then
