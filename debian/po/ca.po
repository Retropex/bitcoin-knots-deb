#: ../bitcoin-knots.templates:20001
msgid "Value for blockprioritysize:"
msgstr "Valor per a «blockprioritysize»:"

#. Type: string
#. Description
#: ../bitcoin-knots.templates:20001
msgid "Set maximum size of high-priority/low-fee transactions in bytes."
msgstr ""
