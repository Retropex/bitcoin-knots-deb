#!/bin/bash

set -e

USER="bitcoin"

case "$1" in
  purge)
    if getent passwd $USER >/dev/null; then
      deluser --system $USER || true
    fi
    
    if [ -f /etc/bitcoin/bitcoin.conf ]; then
      dpkg-statoverride --remove --force-statoverride-remove /etc/bitcoin/bitcoin.conf
    fi
    
    if [ -d "/var/lib/bitcoin" ]; then
      rm -rf /var/lib/bitcoin || true
    fi
    ;;
    
  upgrade|remove|failed-upgrade|abort-install|abort-upgrade|disappear)
    ;;
esac

#DEBHELPER#

exit 0
