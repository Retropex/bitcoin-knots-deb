#!/bin/sh

set -e

USER="bitcoin"

# Source debconf library
. /usr/share/debconf/confmodule

disable_txindex () {
  if grep -s -q -E '^#?txindex=' /etc/bitcoin/bitcoin.conf; then
    sed -i -E "/^#?txindex=/c\txindex=0" /etc/bitcoin/bitcoin.conf
  else
    db_input high bitcoin-knots/txindex-fail || true
    db_go || true
  fi
}

case "$1" in
  configure|reconfigure)
  
  if ! getent passwd $USER >/dev/null; then
      adduser --group --system --no-create-home --home /nonexistent $USER >/dev/null || true
  fi
  
  if getent group debian-tor >/dev/null; then
    usermod -aG debian-tor $USER >/dev/null || true
  fi

  # Add the /etc/bitcoin/bitcoin.conf stat override if it doesn't already exist.
  if ! dpkg-statoverride --list /etc/bitcoin/bitcoin.conf >/dev/null 2>&1; then
    dpkg-statoverride --update --add bitcoin bitcoin 0640 /etc/bitcoin/bitcoin.conf
  fi
  
  # Add the /var/lib/bitcoin stat override if it doesn't already exist.
  if ! dpkg-statoverride --list /var/lib/bitcoin >/dev/null 2>&1; then
    dpkg-statoverride --update --add bitcoin bitcoin 0755 /var/lib/bitcoin
  fi
  
  if [ -f /etc/bitcoin/bitcoin.conf ]; then
    db_get bitcoin-knots/prune-bool || RET=
    if [ "$RET" = "true" ]; then
      db_get bitcoin-knots/prune || RET=
      if [ "$RET" ]; then
        disable_txindex
        if grep -s -q -E '^#?prune=' /etc/bitcoin/bitcoin.conf; then
          sed -i -E "/^#?prune=/c\prune=$RET" /etc/bitcoin/bitcoin.conf
        else
          db_input high bitcoin-knots/prune-bool-fail || true
          db_go || true
        fi
      fi
      unset RET
      
      db_get bitcoin-knots/pruneduringinit || RET=
      if [ "$RET" ]; then
        if grep -s -q -E '^#?pruneduringinit=' /etc/bitcoin/bitcoin.conf; then
          sed -i -E "/^#?pruneduringinit=/c\pruneduringinit=$RET" /etc/bitcoin/bitcoin.conf
        else
          db_input high bitcoin-knots/pruneduringinit-fail || true
          db_go || true
        fi
      fi
    elif [ "$RET" = "false" ]; then
      if grep -s -q -E '^#?pruneduringinit=' /etc/bitcoin/bitcoin.conf; then
        sed -i -E "/^#?pruneduringinit=/c\pruneduringinit=-1" /etc/bitcoin/bitcoin.conf
      else
        db_input high bitcoin-knots/pruneduringinit-fail || true
        db_go || true
      fi
      
      if grep -s -q -E '^#?prune=' /etc/bitcoin/bitcoin.conf; then
        sed -i -E "/^#?prune=/c\prune=0" /etc/bitcoin/bitcoin.conf
      else
        db_input high bitcoin-knots/prune-bool-fail || true
        db_go || true
      fi
    fi
    unset RET
    
    db_get bitcoin-knots/prune-bool || RET=
    if [ "$RET" = "false" ]; then
      db_get bitcoin-knots/txindex || RET=
      if [ "$RET" = "true" ]; then
        if grep -s -q -E '^#?txindex=' /etc/bitcoin/bitcoin.conf; then
          sed -i -E "/^#?txindex=/c\txindex=1" /etc/bitcoin/bitcoin.conf
        else
          db_input high bitcoin-knots/txindex-fail || true
          db_go || true
        fi
      elif [ "$RET" = "false" ]; then
        disable_txindex
      fi
    fi
    unset RET
    
    db_get bitcoin-knots/dbcache || RET=
    if [ "$RET" ]; then
      if grep -s -q -E '^#?dbcache=' /etc/bitcoin/bitcoin.conf; then
        sed -i -E "/^#?dbcache=/c\dbcache=$RET" /etc/bitcoin/bitcoin.conf
      else
        db_input high bitcoin-knots/dbcache-fail || true
        db_go || true
      fi
    fi
    unset RET
    
    db_get bitcoin-knots/rpcthreads || RET=
    if [ "$RET" ]; then
      if grep -s -q -E '^#?rpcthreads=' /etc/bitcoin/bitcoin.conf; then
        sed -i -E "/^#?rpcthreads=/c\rpcthreads=$RET" /etc/bitcoin/bitcoin.conf
      else
        db_input high bitcoin-knots/rpcthreads-fail || true
        db_go || true
      fi
    fi
    unset RET
    
    db_get bitcoin-knots/rpcworkqueue || RET=
    if [ "$RET" ]; then
      if grep -s -q -E '^#?rpcworkqueue=' /etc/bitcoin/bitcoin.conf; then
        sed -i -E "/^#?rpcworkqueue=/c\rpcworkqueue=$RET" /etc/bitcoin/bitcoin.conf
      else
        db_input high bitcoin-knots/rpcworkqueue-fail || true
        db_go || true
      fi
    fi
    unset RET
    
    db_get bitcoin-knots/blockprioritysize || RET=
    if [ "$RET" ]; then
      if grep -s -q -E '^#?blockprioritysize=' /etc/bitcoin/bitcoin.conf; then
        sed -i -E "/^#?blockprioritysize=/c\blockprioritysize=$RET" /etc/bitcoin/bitcoin.conf
      else
        db_input high bitcoin-knots/blockprioritysize-fail || true
        db_go || true
      fi
    fi
    unset RET
    
    db_get bitcoin-knots/blockmaxsize || RET=
    if [ "$RET" ]; then
      if grep -s -q -E '^#?blockmaxsize=' /etc/bitcoin/bitcoin.conf; then
        sed -i -E "/^#?blockmaxsize=/c\blockmaxsize=$RET" /etc/bitcoin/bitcoin.conf
      else
        db_input high bitcoin-knots/blockmaxsize-fail || true
        db_go || true
      fi
    fi
    unset RET
    
    db_get bitcoin-knots/blockmaxweight || RET=
    if [ "$RET" ]; then
      if grep -s -q -E '^#?blockmaxweight=' /etc/bitcoin/bitcoin.conf; then
        sed -i -E "/^#?blockmaxweight=/c\blockmaxweight=$RET" /etc/bitcoin/bitcoin.conf
      else
        db_input high bitcoin-knots/blockmaxweight-fail || true
        db_go || true
      fi
    fi
    unset RET
    
    db_get bitcoin-knots/maxmempool || RET=
    if [ "$RET" ]; then
      if grep -s -q -E '^#?maxmempool=' /etc/bitcoin/bitcoin.conf; then
        sed -i -E "/^#?maxmempool=/c\maxmempool=$RET" /etc/bitcoin/bitcoin.conf
      else
        db_input high bitcoin-knots/maxmempool-fail || true
        db_go || true
      fi
    fi
    unset RET
    
    db_get bitcoin-knots/blockreconstructionextratxn || RET=
    if [ "$RET" ]; then
      if grep -s -q -E '^#?blockreconstructionextratxn=' /etc/bitcoin/bitcoin.conf; then
        sed -i -E "/^#?blockreconstructionextratxn=/c\blockreconstructionextratxn=$RET" /etc/bitcoin/bitcoin.conf
      else
        db_input high bitcoin-knots/blockreconstructionextratxn-fail || true
        db_go || true
      fi
    fi
    unset RET
    
    db_get bitcoin-knots/blockreconstructionextratxnsize || RET=
    if [ "$RET" ]; then
      if grep -s -q -E '^#?blockreconstructionextratxnsize=' /etc/bitcoin/bitcoin.conf; then
        sed -i -E "/^#?blockreconstructionextratxnsize=/c\blockreconstructionextratxnsize=$RET" /etc/bitcoin/bitcoin.conf
      else
        db_input high bitcoin-knots/blockreconstructionextratxnsize-fail || true
        db_go || true
      fi
    fi
    unset RET
    
    db_get bitcoin-knots/maxorphantx || RET=
    if [ "$RET" ]; then
      if grep -s -q -E '^#?maxorphantx=' /etc/bitcoin/bitcoin.conf; then
        sed -i -E "/^#?maxorphantx=/c\maxorphantx=$RET" /etc/bitcoin/bitcoin.conf
      else
        db_input high bitcoin-knots/maxorphantx-fail || true
        db_go || true
      fi
    fi
    unset RET
  fi
  
  db_stop
  ;;
esac

#DEBHELPER#

exit 0
