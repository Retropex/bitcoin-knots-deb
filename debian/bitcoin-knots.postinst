#!/bin/bash

set -e

USER="bitcoin"

case "$1" in
  configure|reconfigure)
  
  if ! getent passwd $USER >/dev/null; then
      adduser --group --system --no-create-home --home /nonexistent $USER >/dev/null || true
  fi
  
  if getent group debian-tor >/dev/null; then
    usermod -aG debian-tor $USER >/dev/null || true
  fi
  
  dpkg-statoverride --force-statoverride-add --update --add bitcoin bitcoin 0755 /var/lib/bitcoin
  dpkg-statoverride --force-statoverride-add --update --add bitcoin bitcoin 0640 /etc/bitcoin/bitcoin.conf
  ;;
esac

#DEBHELPER#

exit 0
